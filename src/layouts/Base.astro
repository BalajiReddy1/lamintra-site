---
/**
 * The shell every page shares.
 *
 * This is the whole reason for the build step. Nav and footer were duplicated
 * the moment a second page existed, and CHECKLIST.md called that out as debt
 * taken on knowingly. It is paid here.
 *
 * The migration finished on 2026-08-11. These pages ARE the site now: the
 * hand-written page that used to serve / was moved to legacy/ rather than
 * deleted, and the /v2/ prefix is gone, because a real product does not ship a
 * version number in its URLs.
 */
interface Props {
  title: string;
  description: string;
  /** Omit on the home page, where the wordmark already says where you are. */
  section?: string;
  /** Page-specific structured data, serialised into a JSON-LD block. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

import { jarCommand, currentCli } from '../data/releases';
import '../styles/fonts.css';
import '../styles/design.css';

const { title, description, section, schema } = Astro.props;

/**
 * Analytics: Plausible, chosen 2026-08-11 over Google Analytics.
 *
 * It is cookieless, stores no personal data and needs no consent banner, which
 * is the only reason it can go on a site whose privacy page is a selling point.
 * GA would have needed a banner in front of it and a rewrite of two legal pages
 * to say the opposite of what they say now.
 *
 * `data-domain` is the site's own hostname, so this derives from `site` in
 * astro.config.mjs rather than repeating it. With no `site` set there is no
 * domain to report against, and Plausible would silently record nothing under
 * a wrong name, so the script is simply not emitted. It switches on with the
 * same one-line change as canonical, og:url and the sitemap.
 *
 * The privacy and compliance pages describe this unconditionally. That is the
 * safe direction: they over-disclose until `site` is set, never under-disclose.
 */
const analyticsDomain = Astro.site?.hostname;

/**
 * The absolute URL of this page, and the absolute og:image.
 *
 * Both resolve to null when `site` is unset in astro.config.mjs, and every tag
 * that depends on them is then simply not emitted. That is deliberate: a
 * canonical tag pointing at a domain nobody owns is worse than no canonical
 * tag, and this was the state the site shipped in for weeks.
 *
 * `Astro.site` is the single place the origin is written down. Nothing else in
 * the codebase may hard-code it.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site
  ? new URL('/img/og-card.png', Astro.site).href
  : '/img/og-card.png';

const nav = [
  { href: '/components/', label: 'Components' },
  { href: '/install/', label: 'Install' },
];
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#040200">

<meta name="robots" content="index, follow, max-image-preview:large">

{/* The domain was bought 2026-08-11, so this is the pass the comment here used
    to promise. Until then og:image stayed relative and canonical and og:url
    were absent entirely, because a hard-coded guess at a domain that does not
    exist is worse than an obviously missing tag.

    All three are absolute now and all three are DERIVED from `site`, so there
    is exactly one place a domain is written down. If `site` is ever unset again
    these fall away rather than pointing at a dead origin. */}
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Lamintra">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{/* Derived, because this describes a picture of the command and said the wrong
    filename for as long as the picture did. Alt text that contradicts its own
    image is worse than none. */}
<meta property="og:image:alt" content={`Lamintra. Compose components that aren't Material. The install command: ${jarCommand('add button')}`}>
<meta name="twitter:card" content="summary_large_image">
{/* Redrawn 2026-08-24 alongside the wordmark mark: the old glyph was a
    generic bar-across-a-box, this one is the same L cut from the product's
    own squircle geometry. A chip rather than a bare glyph, because a
    favicon with no background loses contrast against whatever colour the
    browser's own tab strip happens to be. */}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M 8.00 0.00 L 24.00 0.00 L 24.00 0.00 L 27.67 0.07 L 29.06 0.30 L 30.05 0.67 L 30.78 1.22 L 31.33 1.95 L 31.70 2.94 L 31.93 4.33 L 32.00 8.00 L 32.00 24.00 L 32.00 24.00 L 31.93 27.67 L 31.70 29.06 L 31.33 30.05 L 30.78 30.78 L 30.05 31.33 L 29.06 31.70 L 27.67 31.93 L 24.00 32.00 L 8.00 32.00 L 8.00 32.00 L 4.33 31.93 L 2.94 31.70 L 1.95 31.33 L 1.22 30.78 L 0.67 30.05 L 0.30 29.06 L 0.07 27.67 L 0.00 24.00 L 0.00 8.00 L 0.00 8.00 L 0.07 4.33 L 0.30 2.94 L 0.67 1.95 L 1.22 1.22 L 1.95 0.67 L 2.94 0.30 L 4.33 0.07 L 8.00 0.00 Z' fill='%230a0a0b'/><g transform='translate(5,5)'><mask id='fm'><rect width='22' height='22' fill='white'/><path d='M 11.40 0.00 L 19.60 0.00 L 19.60 0.00 L 20.70 0.02 L 21.12 0.09 L 21.41 0.20 L 21.63 0.37 L 21.80 0.59 L 21.91 0.88 L 21.98 1.30 L 22.00 2.40 L 22.00 10.60 L 22.00 10.60 L 21.98 11.70 L 21.91 12.12 L 21.80 12.41 L 21.63 12.63 L 21.41 12.80 L 21.12 12.91 L 20.70 12.98 L 19.60 13.00 L 11.40 13.00 L 11.40 13.00 L 10.30 12.98 L 9.88 12.91 L 9.59 12.80 L 9.37 12.63 L 9.20 12.41 L 9.09 12.12 L 9.02 11.70 L 9.00 10.60 L 9.00 2.40 L 9.00 2.40 L 9.02 1.30 L 9.09 0.88 L 9.20 0.59 L 9.37 0.37 L 9.59 0.20 L 9.88 0.09 L 10.30 0.02 L 11.40 0.00 Z' fill='black'/></mask><path d='M 4.30 0.00 L 17.70 0.00 L 17.70 0.00 L 19.67 0.04 L 20.42 0.16 L 20.95 0.36 L 21.35 0.65 L 21.64 1.05 L 21.84 1.58 L 21.96 2.33 L 22.00 4.30 L 22.00 17.70 L 22.00 17.70 L 21.96 19.67 L 21.84 20.42 L 21.64 20.95 L 21.35 21.35 L 20.95 21.64 L 20.42 21.84 L 19.67 21.96 L 17.70 22.00 L 4.30 22.00 L 4.30 22.00 L 2.33 21.96 L 1.58 21.84 L 1.05 21.64 L 0.65 21.35 L 0.36 20.95 L 0.16 20.42 L 0.04 19.67 L 0.00 17.70 L 0.00 4.30 L 0.00 4.30 L 0.04 2.33 L 0.16 1.58 L 0.36 1.05 L 0.65 0.65 L 1.05 0.36 L 1.58 0.16 L 2.33 0.04 L 4.30 0.00 Z' fill='%23fafafa' mask='url(%23fm)'/></g></svg>">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}

{/* Typefaces are self-hosted from /fonts/ and imported above. The only
    third-party request this page makes is the analytics script below, and it
    is deliberate and disclosed: no fonts.googleapis.com, no preconnect, no CDN,
    no tag manager, no embeds.

    Preloaded because a webfont is only discovered after the CSS has parsed,
    and these two carry every glyph on the page. `crossorigin` is required even
    same-origin - fonts are fetched in CORS mode, and without it the preload is
    ignored and the file is downloaded twice. */}
<link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>

{/* `defer`, and no preconnect: the one metric that matters here is clicks on
    the copy button, and none of that is worth a millisecond of the page's own
    load. A visitor deciding in under a minute must never wait on measurement. */}
{analyticsDomain && (
  <script defer data-domain={analyticsDomain} src="https://plausible.io/js/script.tagged-events.js"></script>
)}

<script is:inline>
  document.documentElement.classList.remove('no-js');
  // Resolve the theme BEFORE first paint. Doing this after would flash the dark
  // page at anyone whose choice is light. `is:inline` keeps Astro from moving
  // it into a bundled module, which would defer it past first paint and
  // reintroduce exactly the flash it exists to prevent.
  (function () {
    var el = document.documentElement, s = null;
    try { s = localStorage.getItem('lamintra-theme'); } catch (e) {}
    if (s !== 'light' && s !== 'dark') {
      s = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    el.setAttribute('data-theme', s);
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', s === 'light' ? '#F5F8F9' : '#040200');

    // Arm the reveal before first paint, and only for a reader who has not
    // asked for less motion. Here rather than in the deferred script because
    // arming sets the START state: done later, the page paints finished and
    // then jumps back to hidden to animate, which is worse than no animation.
    //
    // The timer is the important half, not the arming. Elements are visible by
    // default in the stylesheet and arming HIDES them, so anything that stops
    // the reveal finishing would leave the page blank.
    //
    // UNCONDITIONAL, and that is the correction. This first checked a flag the
    // reveal script sets, which was worthless: the flag says the script started,
    // not that it can function. In a context that produces no animation frames
    // the script sets the flag, never gets a frame to reveal anything in, and
    // the failsafe then politely declines to help. Measured: zero of ten
    // elements revealed, flag true, page blank.
    //
    // Removing the attribute only ever removes the HIDING, so firing it when it
    // was not needed costs nothing - anything already revealed stays revealed.
    // There is no case where checking first is better.
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.setAttribute('data-anim', 'on');
        setTimeout(function () { el.removeAttribute('data-anim'); }, 2500);
      }
    } catch (e) {}
  })();
</script>
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="masthead" id="masthead">
  <div class="shell masthead__inner">
    {/* A mark, not just a word. Added 2026-08-19, redrawn 2026-08-24: the
        outline-and-bar glyph read as a generic window chrome icon and did not
        survive being put next to competitors. This one is an L built by
        cutting one squircle out of another - the same superellipse formula as
        registry/button/src/internal/button/Squircle.kt (n=4.2), not a
        separate geometry invented for marketing. currentColor, so it follows
        the wordmark's ink in both schemes without a second rule. */}
    <a class="wordmark" href="/"><svg class="mark" viewBox="0 0 32 32" width="17" height="17" aria-hidden="true"><defs><mask id="lamintra-mark"><rect width="32" height="32" fill="white"/><path d="M 16.50 0.00 L 28.50 0.00 L 28.50 0.00 L 30.11 0.03 L 30.72 0.13 L 31.15 0.29 L 31.47 0.53 L 31.71 0.85 L 31.87 1.28 L 31.97 1.89 L 32.00 3.50 L 32.00 15.50 L 32.00 15.50 L 31.97 17.11 L 31.87 17.72 L 31.71 18.15 L 31.47 18.47 L 31.15 18.71 L 30.72 18.87 L 30.11 18.97 L 28.50 19.00 L 16.50 19.00 L 16.50 19.00 L 14.89 18.97 L 14.28 18.87 L 13.85 18.71 L 13.53 18.47 L 13.29 18.15 L 13.13 17.72 L 13.03 17.11 L 13.00 15.50 L 13.00 3.50 L 13.00 3.50 L 13.03 1.89 L 13.13 1.28 L 13.29 0.85 L 13.53 0.53 L 13.85 0.29 L 14.28 0.13 L 14.89 0.03 L 16.50 0.00 Z" fill="black"/></mask></defs><path d="M 6.00 0.00 L 26.00 0.00 L 26.00 0.00 L 28.76 0.06 L 29.80 0.22 L 30.54 0.50 L 31.09 0.91 L 31.50 1.46 L 31.78 2.20 L 31.94 3.24 L 32.00 6.00 L 32.00 26.00 L 32.00 26.00 L 31.94 28.76 L 31.78 29.80 L 31.50 30.54 L 31.09 31.09 L 30.54 31.50 L 29.80 31.78 L 28.76 31.94 L 26.00 32.00 L 6.00 32.00 L 6.00 32.00 L 3.24 31.94 L 2.20 31.78 L 1.46 31.50 L 0.91 31.09 L 0.50 30.54 L 0.22 29.80 L 0.06 28.76 L 0.00 26.00 L 0.00 6.00 L 0.00 6.00 L 0.06 3.24 L 0.22 2.20 L 0.50 1.46 L 0.91 0.91 L 1.46 0.50 L 2.20 0.22 L 3.24 0.06 L 6.00 0.00 Z" fill="currentColor" mask="url(#lamintra-mark)"/></svg>Lamintra</a>
    <nav aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={section === item.label ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <a href="https://github.com/BalajiReddy1/lamintra" data-optional-narrow>GitHub</a>
    </nav>
    {/* The version, in the chrome. A library with no visible version reads as
        unmaintained, which is the one objection this category actually has.
        Derived from `currentCli`, so it cannot drift from the jar the install
        page links to. Points at GitHub Releases: release history is a
        repository concern and lives with the code, not on the marketing site. */}
    <a class="version" href="https://github.com/BalajiReddy1/lamintra/releases">{currentCli}</a>
    <div class="scheme" role="group" aria-label="Colour scheme">
      {/* Icons, not the words "Dark" and "Light", since 2026-08-17. Two
          reasons. The label was redundant - the control is a two-state track
          and the pressed half already says which one you are in - and a page
          whose every affordance is a word reads as a document rather than a
          product. Inline SVG rather than an icon font or a sprite: two glyphs
          do not earn a request, and this keeps the one-third-party-origin rule
          intact.

          currentColor throughout, so they follow the pressed and unpressed ink
          without a second colour rule. aria-label carries the name the visible
          text used to, so nothing is lost to a screen reader. */}
      <button type="button" data-scheme="dark" aria-pressed="true" aria-label="Dark">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 13.5A8.2 8.2 0 0 1 10.5 4a8.5 8.5 0 1 0 9.5 9.5Z"/>
        </svg>
      </button>
      <button type="button" data-scheme="light" aria-pressed="false" aria-label="Light">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.4v2.3M12 19.3v2.3M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.4 12h2.3M19.3 12h2.3M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <slot />
</main>

{/* One row: a copyright line and six links.

    It was two rows with an empty <p> between them: the paragraph held the MIT
    line until that was cut on 2026-08-16 and the empty element was left,
    which is what pushed the first nav to the right and forced a second row for
    the legal links. Two rows and a gap for six words.

    The <p> carries text again as of 2026-08-16, which is safe now only because
    the `margin-inline-start: auto` that caused that bug is gone. It needs no
    CSS of its own: `p` has no margin, .colophon sets the size and colour, and
    72ch cannot bind on five words.

    "MIT licensed" rather than "all rights reserved", which would contradict
    /terms/. Both facts are true and both belong here: the copyright is held,
    and it is licensed permissively.

    Still two <nav> elements rather than one, because they are labelled
    differently and a screen reader announcing "Legal" is doing real work. They
    just share a line now. */}
<footer class="colophon">
  <div class="shell colophon__inner">
    <div class="colophon__brand">
      <span class="colophon__mark"><svg class="mark" viewBox="0 0 32 32" width="17" height="17" aria-hidden="true"><defs><mask id="lamintra-mark-footer"><rect width="32" height="32" fill="white"/><path d="M 16.50 0.00 L 28.50 0.00 L 28.50 0.00 L 30.11 0.03 L 30.72 0.13 L 31.15 0.29 L 31.47 0.53 L 31.71 0.85 L 31.87 1.28 L 31.97 1.89 L 32.00 3.50 L 32.00 15.50 L 32.00 15.50 L 31.97 17.11 L 31.87 17.72 L 31.71 18.15 L 31.47 18.47 L 31.15 18.71 L 30.72 18.87 L 30.11 18.97 L 28.50 19.00 L 16.50 19.00 L 16.50 19.00 L 14.89 18.97 L 14.28 18.87 L 13.85 18.71 L 13.53 18.47 L 13.29 18.15 L 13.13 17.72 L 13.03 17.11 L 13.00 15.50 L 13.00 3.50 L 13.00 3.50 L 13.03 1.89 L 13.13 1.28 L 13.29 0.85 L 13.53 0.53 L 13.85 0.29 L 14.28 0.13 L 14.89 0.03 L 16.50 0.00 Z" fill="black"/></mask></defs><path d="M 6.00 0.00 L 26.00 0.00 L 26.00 0.00 L 28.76 0.06 L 29.80 0.22 L 30.54 0.50 L 31.09 0.91 L 31.50 1.46 L 31.78 2.20 L 31.94 3.24 L 32.00 6.00 L 32.00 26.00 L 32.00 26.00 L 31.94 28.76 L 31.78 29.80 L 31.50 30.54 L 31.09 31.09 L 30.54 31.50 L 29.80 31.78 L 28.76 31.94 L 26.00 32.00 L 6.00 32.00 L 6.00 32.00 L 3.24 31.94 L 2.20 31.78 L 1.46 31.50 L 0.91 31.09 L 0.50 30.54 L 0.22 29.80 L 0.06 28.76 L 0.00 26.00 L 0.00 6.00 L 0.00 6.00 L 0.06 3.24 L 0.22 2.20 L 0.50 1.46 L 0.91 0.91 L 1.46 0.50 L 2.20 0.22 L 3.24 0.06 L 6.00 0.00 Z" fill="currentColor" mask="url(#lamintra-mark-footer)"/></svg>Lamintra</span>
      {/* The line that was here before the layout changed, unchanged. The
          reference design carried two lines of build metadata in this slot and
          they were copied across with it on 2026-08-19, which invented content
          nobody asked for and dropped this one. The layout was the thing worth
          taking; what goes in it is this site's own decision.

          "MIT licensed" and not "all rights reserved", which would contradict
          /terms/. */}
      <p class="colophon__meta">&copy; 2026 Lamintra. MIT licensed.</p>
    </div>
    <div class="colophon__nav">
      {/* Two navs rather than one list: they are labelled differently and a
          screen reader announcing "Legal" is doing real work. The six links are
          the six that were here; the layout moved, the destinations did not. */}
      <nav class="colophon__links" aria-label="Footer">
        <a href="https://github.com/BalajiReddy1/lamintra">Source</a>
        <a href="https://github.com/BalajiReddy1/lamintra-registry">Registry</a>
        <a href="https://github.com/BalajiReddy1/lamintra/releases/latest">Releases</a>
      </nav>
      <nav class="colophon__links" aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/compliance/">Compliance</a>
      </nav>
    </div>
  </div>
</footer>

<script is:inline>
  // Scheme control. Shared by every page, which is the point of this layout.
  (function () {
    var root = document.documentElement;
    var buttons = document.querySelectorAll('[data-scheme]');

    function apply(scheme) {
      root.setAttribute('data-theme', scheme);
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-scheme') === scheme));
      });
      /* The specimen renders are NOT swapped here. Both schemes are in the
         markup and CSS picks one, so they change with the attribute above at
         repaint speed. Doing it from JS meant a preload plus a 120ms timeout
         per image, nine of them on the home page, each landing separately. */
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', scheme === 'light' ? '#F5F8F9' : '#040200');
      try { localStorage.setItem('lamintra-theme', scheme); } catch (e) {}
    }

    apply(root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () { apply(btn.getAttribute('data-scheme')); });
    });

    var mast = document.getElementById('masthead');
    var onScroll = function () { mast.dataset.scrolled = String(window.scrollY > 8); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    /* Reveal, and only for the hero.

       There WAS a scroll reveal here, one per section, driven by an
       IntersectionObserver. It is gone, and the reason is worth keeping.

       Measured, not assumed: in a headless render everything below the hero
       came back blank, and in a pane that produces no animation frames all ten
       elements stayed hidden. The observer is fine in a browser someone is
       looking at; it is unreliable in exactly the contexts that matter most -
       crawlers, screenshot capture, embedded webviews - and those are the ones
       where a blank page is never seen by anyone who could report it.
       CHECKLIST section 7 already records this trap from the old page. It took
       reintroducing it to believe it.

       The hero is different: it is always in the viewport, so it needs no
       observer, and the failsafe covers the rest. Below the fold nothing is
       hidden at any point, by anything.

       Two frames, then a timer. The double rAF gets a painted start state so
       the change transitions rather than jumps; the timeout does the same job
       where frames are never produced. Both set the same attribute, so
       whichever arrives first wins and the other is a no-op. */
    var hero = document.querySelectorAll('.hero [data-reveal]');
    var showHero = function () {
      hero.forEach(function (el) { el.setAttribute('data-shown', ''); });
    };
    if (root.hasAttribute('data-anim')) {
      requestAnimationFrame(function () { requestAnimationFrame(showHero); });
      setTimeout(showHero, 120);
    }

    /* Decode the renders the reader cannot currently see.

       Both schemes ship in the markup and CSS picks one, which made the swap a
       repaint rather than nine network requests - that was the 2026-08-16 fix
       and it stands. What it did not fix is that a browser does not DECODE a
       `display: none` image. Nine of the eighteen on this page are therefore
       compressed bytes in memory and nothing else, and the first toggle away
       from the scheme you arrived in has to decode all nine on the main thread
       before it can paint.

       That is why the delay was asymmetric, which is the clue that found it:
       light to dark was slow and dark to light was not, for a reader whose page
       had loaded light. Whichever set you land on is decoded; the other is not,
       until you ask for it.

       `decode()` exists for exactly this and works on a hidden image, since it
       needs only a src. At idle, so it never competes with first paint, and
       every failure is swallowed - this is an optimisation, and a browser
       without `decode()` gets precisely the behaviour it has today.

       Measured wrong once: 34ms, in a pane that produces no frames, which made
       decode look free when it was simply never happening. */
    var warmRenders = function () {
      document.querySelectorAll('img[data-specimen-scheme]').forEach(function (img) {
        if (img.decode) { img.decode().catch(function () {}); }
      });
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(warmRenders, { timeout: 3000 });
    } else {
      setTimeout(warmRenders, 1200);
    }
  })();
</script>
</body>
</html>
