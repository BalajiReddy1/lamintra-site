# Cloudflare Pages reads this file from the build output and applies it at the
# edge. It is copied through from public/ untouched, like robots.txt.
#
# The rule behind the split below: a filename that changes when its contents
# change may be cached forever. A filename that stays the same when its contents
# change may not, however tempting the long max-age looks.

# Astro fingerprints these, so the name IS the version. Safe to keep forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted typefaces. Stable names, but a typeface changes roughly never, and
# a stale one for a day is invisible rather than wrong.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Component renders. NOT fingerprinted: button-dark.png keeps its name when the
# component changes, so `immutable` here would show a returning visitor last
# month's component for a year. That is the exact failure this site exists to
# avoid, so it gets a day, and a week of serving stale while it refetches.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The WebAssembly hero. 3.8MB, so worth caching hard, but the name is stable and
# it is rebuilt whenever a component changes.
/live/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Security headers for every response. Deliberately NO Cache-Control here.
#
# Cloudflare Pages applies EVERY rule whose pattern matches and concatenates the
# values, rather than letting the most specific rule win. A Cache-Control on /*
# was therefore appended to all four rules above, and the first deploy served:
#
#   Cache-Control: public, max-age=31536000, immutable, public, max-age=0, must-revalidate
#
# on the fingerprinted assets. Two conflicting sets of directives in one header,
# where the restrictive half wins, so the long cache the rules above exist for
# was doing nothing at all. Caught by reading the response headers off the live
# deploy; nothing local could have shown it.
#
# HTML gets Cloudflare's own default for a Pages project, which is already
# max-age=0, must-revalidate. Verified on the deploy after this one.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
